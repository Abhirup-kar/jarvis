# ==============================================================================
# JARVIS Configuration & Secrets Template
# Copy this file to '.env' (e.g. `cp config/secrets.example.env .env`)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BRAIN / LLM CONFIGURATION
# ------------------------------------------------------------------------------
# OpenAI (Default):
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#LLM_MODEL=gpt-4o-mini

# Alternative 1 - Groq (Super-fast with free tier):
# OPENAI_API_KEY=gsk_your_groq_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Alternative 2 - Ollama (100% Local & Free):
 OPENAI_API_KEY=llx-ytPNHgilavCaKyJVNLQGTv6SahATr8Gqp1aU0WA98CaVA91j
 OPENAI_BASE_URL=http://localhost:11434/v1
 LLM_MODEL=llama3.2

# Alternative 3 - OpenRouter:
# OPENAI_API_KEY=sk-or-v1-your_openrouter_key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. VOICE & SPEECH SYNTHESIS
# ------------------------------------------------------------------------------
# TTS Voice options:
# en-GB-RyanNeural   (British Male - Classic JARVIS)
# en-GB-SoniaNeural  (British Female - FRIDAY style)
# en-US-GuyNeural    (American Male)
TTS_VOICE=en-GB-RyanNeural
WAKE_WORD=hey_jarvis

# ------------------------------------------------------------------------------
# 3. SMART HOME INTEGRATIONS (Optional)
# ------------------------------------------------------------------------------
# Home Assistant (Local IP or http://homeassistant.local:8123)
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=your_long_lived_access_token_here

# MQTT Broker (Mosquitto / Zigbee2MQTT / Tasmota)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ------------------------------------------------------------------------------
# 4. NOTIFICATIONS & AUTOMATION (Optional)
# ------------------------------------------------------------------------------
# Email sending via SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=karabhirup49@gmail.com
SENDER_PASSWORD=Abhi123@#

# Discord or Slack Webhook for instant push alerts
SLACK_OR_DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 5. HARDWARE & PERIPHERALS
# ------------------------------------------------------------------------------
CAMERA_INDEX=0
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000